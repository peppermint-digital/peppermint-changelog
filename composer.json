{
    "name": "peppermint/changelog",
    "description": "File-based changelog system for Laravel with per-user read tracking and modal notifications. Supports React and Vue frontends with shadcn/ui.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Peppermint Digital",
            "email": "hello@peppermint-digital.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "symfony/yaml": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Peppermint\\Changelog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Peppermint\\Changelog\\ChangelogServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
